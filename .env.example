# Server-side only. NEVER prefix with VITE_ (that would expose the key to the browser).
# Copy to .env (git-ignored) for local testing, or set these in your host's environment settings.
# The AI compiler is OFF unless AI_ENABLED is exactly "true" AND a key and model are set.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional best-effort limits (in-memory, per server instance; not a substitute for provider budgets)
# AI_RATE_PER_MINUTE=6
# AI_DAILY_LIMIT=200
